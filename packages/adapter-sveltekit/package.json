{
  "name": "@bozhidar003/vibe-design-adapter-sveltekit",
  "private": true,
  "version": "0.1.0",
  "description": "SvelteKit adapter for Vibe Design",
  "type": "module",
  "license": "MIT",
  "author": "Bozhidar Kamenski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bozhdiar003/vibe_design.git",
    "directory": "packages/adapter-sveltekit"
  },
  "homepage": "https://github.com/Bozhdiar003/vibe_design#readme",
  "bugs": {
    "url": "https://github.com/Bozhdiar003/vibe_design/issues"
  },
  "keywords": [
    "vibe-design",
    "sveltekit",
    "adapter"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
