{
  "name": "@bozhidar003/vibe-design-server",
  "private": true,
  "version": "0.1.0",
  "description": "WebSocket server for Vibe Design overlay communication",
  "type": "module",
  "license": "MIT",
  "author": "Bozhidar Kamenski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bozhdiar003/vibe_design.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Bozhdiar003/vibe_design#readme",
  "bugs": {
    "url": "https://github.com/Bozhdiar003/vibe_design/issues"
  },
  "keywords": [
    "vibe-design",
    "server",
    "websocket"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "express": "^4.18.0",
    "ws": "^8.16.0",
    "glob": "^10.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/ws": "^8.5.0"
  }
}
