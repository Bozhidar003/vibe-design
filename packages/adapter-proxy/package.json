{
  "name": "@bozhidar003/vibe-design-adapter-proxy",
  "private": true,
  "version": "0.1.0",
  "description": "HTTP proxy adapter for Vibe Design",
  "type": "module",
  "license": "MIT",
  "author": "Bozhidar Kamenski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bozhdiar003/vibe_design.git",
    "directory": "packages/adapter-proxy"
  },
  "homepage": "https://github.com/Bozhdiar003/vibe_design#readme",
  "bugs": {
    "url": "https://github.com/Bozhdiar003/vibe_design/issues"
  },
  "keywords": [
    "vibe-design",
    "proxy",
    "adapter"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "vibe-proxy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "http-proxy": "^1.18.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "@types/http-proxy": "^1.17.0"
  }
}
